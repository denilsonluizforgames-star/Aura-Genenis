<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ── Paleta padrão = Lunar (noite). Solar é aplicado em runtime via App.ApplyColors ── -->
            <Color x:Key="AuraBackground">#12141f</Color>
            <Color x:Key="AuraSurface">#0d0f18</Color>
            <Color x:Key="AuraSurface2">#1e2130</Color>
            <Color x:Key="AuraAccent">#7a9eff</Color>
            <Color x:Key="AuraAccentDim">#14224a</Color>
            <Color x:Key="AuraAccentGlow">#0e1a35</Color>
            <Color x:Key="AuraAccent2">#8a5ae0</Color>
            <Color x:Key="AuraCyan">#7a9eff</Color>
            <Color x:Key="AuraCyanDim">#14224a</Color>
            <Color x:Key="AuraTextPrimary">#eef0f5</Color>
            <Color x:Key="AuraTextSecondary">#b8bcc8</Color>
            <Color x:Key="AuraTextMuted">#5a5e70</Color>
            <Color x:Key="AuraSuccess">#6cdb9a</Color>
            <Color x:Key="AuraError">#e05560</Color>
            <Color x:Key="AuraWarning">#f5b85a</Color>
            <Color x:Key="AuraBorder">#2a2d40</Color>
            <Color x:Key="AuraBorderAccent">#2a3a6a</Color>
            <Color x:Key="AuraUserBubble">#1e2d54</Color>
            <Color x:Key="AuraAgentBubble">#0d0f18</Color>
            <Color x:Key="AuraToolBubble">#0f1420</Color>
            <!-- Glass aproximado (alpha) — sem backdrop-blur nativo / zero NuGet -->
            <Color x:Key="AuraGlass">#990d0f18</Color>
            <Color x:Key="AuraGlassBorder">#33ffffff</Color>

            <!-- ── Estilos globais (DynamicResource = troca de tema ao vivo) ── -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AuraTextPrimary}" />
                <Setter Property="FontFamily" Value="OpenSans" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{DynamicResource AuraTextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource AuraTextMuted}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraSurface2}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{DynamicResource AuraTextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{DynamicResource AuraTextMuted}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraSurface2}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{DynamicResource AuraTextPrimary}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraSurface2}" />
                <Setter Property="TitleColor" Value="{DynamicResource AuraTextMuted}" />
            </Style>

            <!-- Botão primário (accent) -->
            <Style x:Key="BtnPrimary" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraAccent}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
            </Style>

             <!-- Botão fantasma (ghost) -->
             <Style x:Key="BtnGhost" TargetType="Button">
                 <Setter Property="BackgroundColor" Value="{DynamicResource AuraSurface2}" />
                 <Setter Property="TextColor" Value="{DynamicResource AuraAccent}" />
                 <Setter Property="CornerRadius" Value="10" />
                 <Setter Property="Padding" Value="14,8" />
                 <Setter Property="FontSize" Value="13" />
             </Style>

             <!-- Estilo de cabeçalho -->
             <Style x:Key="Heading" TargetType="Label">
                 <Setter Property="TextColor" Value="{DynamicResource AuraTextPrimary}" />
                 <Setter Property="FontSize" Value="24" />
                 <Setter Property="FontAttributes" Value="Bold" />
                 <Setter Property="FontFamily" Value="IBMPlexSans" />
             </Style>

            <!-- Botão destrutivo -->
            <Style x:Key="BtnDanger" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraError}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Card padrão -->
            <Style x:Key="AuraCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraSurface}" />
                <Setter Property="Stroke" Value="{DynamicResource AuraBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card com borda accent -->
            <Style x:Key="AuraCardAccent" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraSurface}" />
                <Setter Property="Stroke" Value="{DynamicResource AuraBorderAccent}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Superfície glass (barra inferior / overlays) -->
            <Style x:Key="AuraGlassBar" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AuraGlass}" />
                <Setter Property="Stroke" Value="{DynamicResource AuraGlassBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="8,10" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="18" />
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
