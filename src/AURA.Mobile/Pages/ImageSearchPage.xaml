<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AURA.Mobile.Pages.ImageSearchPage"
             Title="Imagem reversa"
             BackgroundColor="{DynamicResource AuraBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="12" RowSpacing="10">

        <VerticalStackLayout Spacing="6">
            <Label Text="Busca de imagem reversa em vários servidores"
                   FontAttributes="Bold"
                   FontSize="15"
                   TextColor="{DynamicResource AuraTextPrimary}" />
            <Label Text="Informe a URL da imagem ou envie uma da galeria. Provedores: Google Lens, Bing Visual, TinEye e Yandex."
                   FontSize="12"
                   TextColor="{DynamicResource AuraTextSecondary}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Picker x:Name="ProviderPicker"
                    Title="Provedor" />
            <Button Grid.Column="1"
                    x:Name="GalleryButton"
                    Text="Da galeria"
                    Clicked="OnGalleryClicked"
                    BackgroundColor="{DynamicResource AuraAccent}"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="12,8" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="ImageUrlEntry"
                   Placeholder="URL da imagem (https://...)"
                   Keyboard="Url"
                   ReturnType="Search"
                   Completed="OnByUrlClicked"
                   TextColor="{DynamicResource AuraTextPrimary}"
                   PlaceholderColor="{DynamicResource AuraTextSecondary}" />
            <Button Grid.Column="1"
                    x:Name="SearchButton"
                    Text="Buscar"
                    Clicked="OnByUrlClicked"
                    BackgroundColor="{DynamicResource AuraAccent}"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="14,8" />
        </Grid>

        <Label x:Name="StatusLabel"
               Grid.Row="3"
               FontSize="12"
               TextColor="{DynamicResource AuraTextSecondary}"
               IsVisible="False" />

        <WebView x:Name="Results"
                 Grid.Row="3"
                 Navigating="OnNavigating"
                 IsVisible="False" />

    </Grid>
</ContentPage>
